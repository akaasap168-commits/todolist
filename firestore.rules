rules_version = '2';

// Only the listed Firebase Auth UIDs can read or write their own data.
// Replace REPLACE_WITH_YOUR_UID with the UID shown in the app's settings dialog,
// then paste this file into Firebase console > Firestore Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid in ['REPLACE_WITH_YOUR_UID'];
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
